<UserControl x:Class="justsayo_win.SubmodDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:justsayo_win"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=local:SubmodItem}">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{DynamicResource SlideInAnimation}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <!-- left column: image and back button -->
        <StackPanel Grid.Column="0" Margin="0,0,40,0">
            <Button Content="&lt;-- Go Back"
                    Command="{Binding DataContext.GoBackCommand, RelativeSource={RelativeSource AncestorType=local:SubmodsView}}"
                    HorizontalAlignment="Left" Background="Transparent" Foreground="White" BorderThickness="0" Margin="0,0,0,20" Cursor="Hand"/>
            
            <Border CornerRadius="8" Background="#11000000">
                <Image Source="{Binding PreviewImageUrl}" Stretch="Uniform" />
            </Border>
        </StackPanel>

        <!-- right column: details and actions -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="36" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                <TextBlock Foreground="#CCFFFFFF" FontSize="16" Margin="0,5,0,20">
                    <Run Text="by"/>
                    <Run Text="{Binding Author}" FontWeight="SemiBold"/>
                    <Run Text=" - Version"/>
                    <Run Text="{Binding Version}" FontWeight="SemiBold"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                    <!-- install button -->
                    <Button Content="Install"
                            Command="{Binding DataContext.InstallSubmodCommand, RelativeSource={RelativeSource AncestorType=local:SubmodsView}}"
                            CommandParameter="{Binding}"                           
                            Visibility="{Binding Status, ConverterParameter=NotInstalled, Converter={StaticResource SubmodStatusToVisibilityConverter}}"
                            Background="#FF89B4FA" Foreground="#FF1E1E2E" FontSize="16" FontWeight="Bold" Padding="25,10" BorderThickness="0" Margin="0,0,10,0">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{StaticResource AndLogicMultiConverter}">
                                <Binding Path="IsInstalling" Converter="{StaticResource BooleanInverterConverter}"/>
                                <Binding Path="DataContext.IsMainGameInstalled" RelativeSource="{RelativeSource AncestorType=local:SubmodsView}"/>
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>
                    
                    <!-- update button -->
                    <Button Content="Update"
                            Command="{Binding DataContext.InstallSubmodCommand, RelativeSource={RelativeSource AncestorType=local:SubmodsView}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding Status, ConverterParameter=UpdateAvailable, Converter={StaticResource SubmodStatusToVisibilityConverter}}"
                            Background="#FFFAB387" Foreground="#FF1E1E2E" FontSize="16" FontWeight="Bold" Padding="25,10" BorderThickness="0" Margin="0,0,10,0">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{StaticResource AndLogicMultiConverter}">
                                <Binding Path="IsInstalling" Converter="{StaticResource BooleanInverterConverter}"/>
                                <Binding Path="DataContext.IsMainGameInstalled" RelativeSource="{RelativeSource AncestorType=local:SubmodsView}"/>
                            </MultiBinding>
                        </Button.IsEnabled>
                    </Button>

                    <!-- uninstall button -->
                    <Button Content="Uninstall"
                            Command="{Binding DataContext.UninstallSubmodCommand, RelativeSource={RelativeSource AncestorType=local:SubmodsView}}"
                            CommandParameter="{Binding}"
                            IsEnabled="{Binding IsInstalling, Converter={StaticResource BooleanInverterConverter}}"
                            Visibility="{Binding Status, ConverterParameter='Installed|UpdateAvailable', Converter={StaticResource SubmodStatusToVisibilityConverter}}"
                            Background="#FFF38BA8" Foreground="#FF1E1E2E" FontSize="16" FontWeight="Bold" Padding="25,10" BorderThickness="0"/>
                </StackPanel>

                <!-- progress bar -->
                <ProgressBar Value="{Binding InstallProgress}" Maximum="100" Height="10" Margin="0,0,0,20"
                             Visibility="{Binding IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}"
                             BorderThickness="0" Background="#33FFFFFF" Foreground="#FF89B4FA"/>

                <!-- description -->
                <TextBlock Text="Description" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,10"/>
                <TextBlock Text="{Binding Description}" Foreground="#DDFFFFFF" TextWrapping="Wrap" LineHeight="22"/>

                <TextBlock Text="Package Contents" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,25,0,10"/>
                <TextBlock Text="{Binding PackageContents}" Foreground="#DDFFFFFF" TextWrapping="Wrap" LineHeight="22"/>

                <!-- reset Status button -->
                <Button Content="Reset Installation Status"
                        Command="{Binding DataContext.ResetStatusCommand, RelativeSource={RelativeSource AncestorType=local:SubmodsView}}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding IsInstalling, Converter={StaticResource BooleanInverterConverter}}"
                        Visibility="{Binding Status, ConverterParameter='Installed|UpdateAvailable', Converter={StaticResource SubmodStatusToVisibilityConverter}}"
                        HorizontalAlignment="Left" Background="Transparent" Foreground="#CCFFFFFF" BorderThickness="0" Margin="0,30,0,0"
                        ToolTip="Use this if you manually deleted files and want the launcher to mark this as 'Not Installed'."/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>