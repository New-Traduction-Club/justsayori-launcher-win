<Window x:Class="justsayo_win.MoveGameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Installation Path" Height="200" Width="450"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E" Foreground="White" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- question view -->
        <StackPanel x:Name="QuestionView">
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                       Text="The game is already installed in the previous location. What would you like to do?"/>
        </StackPanel>

        <!-- progress view -->
        <StackPanel x:Name="ProgressView" Visibility="Collapsed" VerticalAlignment="Center">
            <TextBlock x:Name="ProgressText" Text="Moving files..." TextAlignment="Center" Margin="0,0,0,10"/>
            <ProgressBar IsIndeterminate="True" Height="5"/>
        </StackPanel>


        <StackPanel x:Name="ButtonPanel" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Move Files" Click="MoveButton_Click" Padding="10,5" Margin="0,0,10,0" Background="#FF89B4FA" Foreground="#FF1E1E2E" FontWeight="Bold"/>
            <Button Content="Delete Old" Click="DeleteButton_Click" Padding="10,5" Margin="0,0,10,0" Background="#FFF38BA8" Foreground="#FF1E1E2E" FontWeight="Bold"/>
            <Button Content="Just Change Path" Click="ChangePathButton_Click" Padding="10,5" Background="#55FFFFFF" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
