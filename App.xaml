<Application x:Class="justsayo_win.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:justsayo_win"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <local:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <local:SubmodStatusToVisibilityConverter x:Key="SubmodStatusToVisibilityConverter"/>
        <local:BooleanInverterConverter x:Key="BooleanInverterConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <local:AndLogicMultiConverter x:Key="AndLogicMultiConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Application.Resources>
</Application>
